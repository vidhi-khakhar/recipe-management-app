<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="589.0" prefWidth="905.0" stylesheets="@FoodPal.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.MainCtrl">
    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <top>
                <HBox prefHeight="100.0" styleClass="header" BorderPane.alignment="TOP_LEFT">
                    <children>
                        <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Pane prefHeight="96.0" prefWidth="35.0" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="searchBar" prefHeight="31.0" prefWidth="218.0" promptText="Enter your query..." styleClass="searchbar" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="favoriteS" mnemonicParsing="false" onAction="#searchFavorites" prefHeight="31.0" styleClass="roundbutton" text="S">
                                            <HBox.margin>
                                                <Insets left="4.0" />
                                            </HBox.margin>
                                        </Button>
                                        <Pane prefHeight="96.0" prefWidth="106.0" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                                <Label alignment="CENTER" prefHeight="54.0" prefWidth="179.0" text="FoodPal">
                                    <font>
                                        <Font name="Cascadia Code Regular" size="37.0" />
                                    </font>
                                    <styleClass>
                                        <String fx:value="h1" />
                                        <String fx:value="headerlabel" />
                                    </styleClass>
                                </Label>
                                <HBox alignment="BOTTOM_RIGHT" prefHeight="100.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#refreshButtonClicked" styleClass="roundbutton" text="R">
                                            <HBox.margin>
                                                <Insets bottom="5.0" right="5.0" />
                                            </HBox.margin>
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </top>
            <left>
                <VBox prefWidth="264.0" BorderPane.alignment="CENTER">
                    <children>
                        <HBox maxHeight="-Infinity" prefHeight="46.0" VBox.vgrow="NEVER">
                            <children>
                                <Button fx:id="shoppingListButton" mnemonicParsing="false" onAction="#showShoppingListWindow" prefHeight="34.0" prefWidth="122.0" text="Shopping List">
                                    <HBox.margin>
                                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                    </HBox.margin>
                                </Button>
                                <Button fx:id="nutritionalValueButton" mnemonicParsing="false" onAction="#showNutritionWindow" prefHeight="34.0" prefWidth="128.0" text="Nutritional Value">
                                    <HBox.margin>
                                        <Insets bottom="5.0" left="5.0" right="7.0" top="5.0" />
                                    </HBox.margin>
                                </Button>
                            </children>
                        </HBox>
                        <VBox styleClass="sidebar" VBox.vgrow="ALWAYS">
                            <children>
                                <ListView fx:id="sidebarList" onMouseClicked="#updateRecipeStackPane" styleClass="sidebar-list" VBox.vgrow="ALWAYS">
                                    <VBox.margin>
                                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                    </VBox.margin>
                                </ListView>
                                <HBox alignment="CENTER" prefHeight="50.0">
                                    <children>
                                        <Button fx:id="addRecipeButton1" onAction="#showAddRecipeWindow" prefHeight="38.0" prefWidth="161.0" text="+ Add" />
                                        <Button fx:id="removeRecipeButton" onAction="#recipeRemoveButtonClicked" prefHeight="23.0" prefWidth="43.0" text="-" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </left>
            <center>
                <StackPane>
                    <children>
                        <AnchorPane fx:id="noRecipePane" visible="false">
                            <children>
                                <VBox alignment="CENTER" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
                                    <Label text="No Recipes Created!" />
                                    <Label text="Please select a recipe." />
                                </VBox>
                            </children>
                        </AnchorPane>
                        <AnchorPane fx:id="allRecipePane">
                            <children>
                                <VBox spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                                    <children>
                                        <HBox spacing="10.0">
                                            <Label fx:id="titleRecipeLabel" styleClass="h2" text="Recipe Title" />
                                            <Button fx:id="editRecipeTitleButton" onAction="#editRecipeTitleButtonClicked" text="Edit" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Button fx:id="cloneRecipeButton" onAction="#cloneRecipe" text="Clone" />
                                        </HBox>
                                        <Label styleClass="h3" text="Ingredients:" />
                                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                                            <VBox fx:id="ingredientList" spacing="5.0" />
                                        </ScrollPane>
                                        <HBox spacing="10.0">
                                            <Button fx:id="addIngredientButton" onAction="#ingredientAddButtonClicked" text="+" />
                                            <Button fx:id="recipeShoppingButton" onAction="#showRecipeShoppingWindow" text="Shop 🛒" />
                                        </HBox>
                                        <Label styleClass="h3" text="Preparation:" />
                                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                                            <VBox fx:id="preparationList" />
                                        </ScrollPane>
                                        <Button fx:id="downloadButton" onAction="#downloadButtonClicked" text="Download" />
                                    </children>
                                </VBox>
                            </children>
                        </AnchorPane>
                    </children>
                </StackPane>
            </center>
        </BorderPane>
    </children>
</AnchorPane>