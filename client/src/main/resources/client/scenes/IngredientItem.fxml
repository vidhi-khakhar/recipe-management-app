<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane fx:id="ingredientItem" hgap="10.0" vgap="5.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.IngredientItemCtrl">
   <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" prefWidth="200.0" />
      <ColumnConstraints hgrow="NEVER" minWidth="80.0" prefWidth="80.0" />
      <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="120.0" />
      <ColumnConstraints hgrow="NEVER" minWidth="40.0" prefWidth="40.0" />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
   </rowConstraints>
   <children>
      <TextField fx:id="nameField" prefHeight="25.0" promptText="Ingredient name" GridPane.columnIndex="0" GridPane.rowIndex="0" />
      <TextField fx:id="amountField" prefHeight="25.0" promptText="Amount" GridPane.columnIndex="1" GridPane.rowIndex="0" />
      <ComboBox fx:id="unitComboBox" prefHeight="25.0" prefWidth="150.0" promptText="Unit" GridPane.columnIndex="2" GridPane.rowIndex="0" />
      <Button fx:id="removeButton" mnemonicParsing="false" onAction="#removeIngredient" prefHeight="25.0" prefWidth="25.0" styleClass="roundbutton" text="❌" GridPane.columnIndex="3" GridPane.rowIndex="0">
         <GridPane.margin>
            <Insets left="5.0" />
         </GridPane.margin>
      </Button>
   </children>
   <padding>
      <Insets bottom="2.0" left="2.0" right="2.0" top="2.0" />
   </padding>
</GridPane>